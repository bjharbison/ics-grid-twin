/*
 * secrets.h.example — copy to secrets.h and fill in.
 *
 *   cp secrets.h.example secrets.h
 *
 * secrets.h is gitignored. Never commit it. Never paste real values into
 * documentation, issues, or chat logs.
 *
 * The MQTT account below must be the FIELD account (least privilege):
 * publish to its role topic tree + read cmd/#. It must NOT be an account
 * with readwrite on '#'. See infra/mosquitto/config/acl.example.
 */

#ifndef SECRETS_H
#define SECRETS_H

// ---- WiFi ----
#define WIFI_SSID       "your-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// ---- MQTT broker ----
#define MQTT_HOST       "203.0.113.163"   // broker IP. Use an IP, not a Docker hostname.
#define MQTT_PORT       1883
#define MQTT_USER       "esp32-field"
#define MQTT_PASS       "your-field-password"

// ---- OTA ----
// Guards ArduinoOTA. First flash is USB; every reflash after this can be OTA.
#define OTA_PASSWORD    "your-ota-password"

#endif  // SECRETS_H
