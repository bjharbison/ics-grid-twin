# Copy to .env and fill in. .env is gitignored.
#   cp .env.example .env
#
# Credentials are sourced from Vaultwarden at config time. Nothing here is
# hardcoded anywhere else in the repo.

# ---- MQTT broker ----
MQTT_HOST=192.168.1.163
MQTT_PORT=1883

# Read-only account. This is what the fleet manager and twin use by default.
# ACL: topic read #
MQTT_USER=monitor-reader
MQTT_PASSWORD=

# Supervisory account, used ONLY to send commands (breaker/role).
# Leave blank to run the fleet manager in read-only mode -- command buttons
# stay disabled. This is the recommended default.
# ACL: topic readwrite #
MQTT_CMD_USER=scada-server
MQTT_CMD_PASSWORD=

# ---- InfluxDB ----
INFLUX_URL=http://192.168.1.163:8086
INFLUX_ORG=ICS Lab
INFLUX_BUCKET=ics-telemetry
INFLUX_TOKEN=

# ---- Fleet manager options ----
# Poll each board's HTTP /info endpoint directly (Level 3 -> Level 1).
# Off by default: it is the only path that touches field devices directly.
FLEET_HTTP_POLL=false
# Seconds without telemetry before a board is marked stale.
FLEET_STALE_SECONDS=10

# ---- Mock fleet (scripts/mock_fleet.py) ----
# Simulates the six-board ESP32 fleet with no hardware. Publishes as a field
# device, so it needs the field account -- same one the real boards use.
MQTT_FIELD_USER=esp32-field
MQTT_FIELD_PASSWORD=
