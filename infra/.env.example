# infra/.env.example -- copy to infra/.env and fill in from Vaultwarden.
# infra/.env is gitignored.

# ---- InfluxDB initial setup ----
INFLUX_USER=admin
# 8+ chars. InfluxDB's init has historically choked on some special chars.
INFLUX_PASSWORD=
# Case- and space-sensitive. Must match everywhere: bridge, Grafana, twin.
INFLUX_ORG=ICS Lab
INFLUX_BUCKET=ics-telemetry
# Generate a fresh one: openssl rand -base64 48
INFLUX_TOKEN=

# ---- Grafana ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# ---- Bridge's MQTT identity (read-only) ----
MQTT_USER=monitor-reader
MQTT_PASSWORD=

# ---- Mock fleet (docker compose --profile sim) ----
# The simulator publishes as a field device, so it uses the field account.
MQTT_FIELD_USER=esp32-field
MQTT_FIELD_PASSWORD=
